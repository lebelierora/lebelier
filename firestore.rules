rules_version = '2';

// ============================================================
// るべりえ 注文サイト（lebelier）Firestore セキュリティルール
// 2026-11-26：厨房を Firebase Auth（メール/パスワード）化し、本ルールへ締め付け。
// 厨房アカウントは lebelier.ora@gmail.com の1件だけ（isKitchen で判定）。
// お客様はログインなし：注文の作成と、IDを知っている自分の注文の取得だけ可。
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {
    function isKitchen() {
      return request.auth != null && request.auth.token.email == "lebelier.ora@gmail.com";
    }
    // テイクアウト・冷凍の注文：お客様は「作成」と「自分の注文（IDを知っているもの）の取得」のみ。
    // 全件の閲覧・更新・削除は厨房ログインだけ。
    match /takeoutOrders/{id} {
      allow create: if true;
      allow get: if true;
      allow list, update, delete: if isKitchen();
    }
    // 店内オーダー：同上
    match /dineInOrders/{id} {
      allow create: if true;
      allow get: if true;
      allow list, update, delete: if isKitchen();
    }
    // 店員呼び出し：お客様は作成のみ
    match /calls/{id} {
      allow create: if true;
      allow get, list, update, delete: if isKitchen();
    }
    // 要注意リスト：お客様は自分の番号の登録有無だけ取得可（ID＝電話番号）
    match /blockedPhones/{id} {
      allow get: if true;
      allow list, create, update, delete: if isKitchen();
    }
    // 受け取り枠の日次サマリ：お客様が枠を取り、厨房が動かす/空ける
    match /daySlots/{date} {
      allow get: if true;
      allow create, update: if true;
      allow delete: if isKitchen();
    }
  }
}

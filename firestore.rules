rules_version = '2';

// ============================================================
// るべりえ テイクアウト注文（lebelier）Firestore セキュリティルール
//
// 現状は「誰でも読み書き可」に近い緩い設定です。理由：
// - お客さん側はログインなしで注文・状況確認を行うため
// - 厨房画面はテスト段階では PIN ゲート（クライアント側）で守るため
// テスト公開中のみの前提です。本番運用の前に、必ず下記の締め付けを行うこと。
//
//
// 1. 厨房側を Firebase Authentication（メール/パスワード等）で認証し、
// takeoutOrders の「更新（受付・完了・来店なし）」と blockedPhones の
// 書き込みは request.auth!= null のユーザーだけに許可する。
// 2. takeoutOrders の読み取りは、電話番号＋受け取り日でのクエリに限定し、
// 全件読み取りを禁止する（現状は厨房の全件購読と状況確認のため全読み可）。
// ※ Firestore ルールだけでは「自分の注文だけ」を厳密には守れないため、
// 本番では App Check の導入、または Cloud Functions 経由の取得に移行する。
// 3. create 時のフィールド検証（必須項目・型・金額の上限・文字列長）を追加し、
// いたずらの大量書き込みを防ぐ。あわせて Firebase App Check を有効化する。
// 4. blockedPhones の読み取りは「自分の番号が含まれているか」の判定だけに
// 使うため、本番では存在確認専用の仕組み（Functions等）に分離する。
// ============================================================

service cloud.firestore {
match /databases/{database}/documents {

// テイクアウト注文
match /takeoutOrders/{orderId} {
allow read: if true; // テスト段階：状況確認・厨房購読のため全読み可
allow create: if true; // テスト段階：ログインなし注文のため
allow update: if true; // テスト段階：厨房の受付操作（PINゲート前提）
allow delete: if false; // 削除は誰にも許可しない
}

// 要注意リスト（ノーショーした電話番号）
// ドキュメントID = 電話番号（数字のみ）
match /blockedPhones/{phone} {
allow read: if true; // テスト段階：注文送信時の判定のため
allow create, update, delete: if true; // テスト段階：厨房の登録・解除（PINゲート前提）
}

// それ以外のコレクションはすべて拒否
match /{document=**} {
allow read, write: if false;
}
}
}
